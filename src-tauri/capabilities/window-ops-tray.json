{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-ops-tray",
  "description": "托盘菜单窗口专属操作：菜单高度自适应（setSize）与选毕自隐（hide）。Rust 侧的 prevent_close+hide 走后端不需要前端权限",
  "windows": ["tray-menu"],
  "permissions": [
    "core:window:allow-set-size",
    "core:window:allow-hide"
  ]
}
