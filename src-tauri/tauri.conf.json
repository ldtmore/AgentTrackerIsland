{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "去你的岛",
  "identifier": "com.agenttrackerisland.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "去你的岛",
        "width": 380,
        "height": 48,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "tray-menu",
        "title": "托盘菜单 · 去你的岛",
        "url": "index.html#tray-menu",
        "width": 280,
        "height": 324,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "tooltip",
        "title": "悬停气泡 · 去你的岛",
        "url": "index.html#tooltip",
        "width": 320,
        "height": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LDT",
    "homepage": "https://github.com/ldtmore/AgentTrackerIsland",
    "copyright": "Copyright (c) 2026 LDT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
